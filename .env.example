# ---------------------------------------------------------------------------
# Marilux Beauty Bar — environment
#
# Copy to `.env.local` and fill in what you have. Every integration degrades
# gracefully when its variables are absent: bookings are still recorded and
# acknowledged, and both the server log and the admin dashboard name exactly
# which channel needs attention.
# ---------------------------------------------------------------------------

# Public site URL. Canonical tags, sitemap, OG images and payment callbacks.
NEXT_PUBLIC_SITE_URL=https://mariluxbeautybar.com


# === ADMIN DASHBOARD (required to open /admin) =============================
# Without these the dashboard stays closed — there is no default password.
ADMIN_PASSWORD=choose-a-long-password
# Signs the session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=


# === EMAIL =================================================================
# SMTP. Works with Gmail, Brevo, or any provider.

# -- Option A: Brevo HTTPS API (recommended) --------------------------------
# Preferred in production: many serverless hosts (Vercel, Netlify) block or
# throttle outbound SMTP ports, and an HTTPS call always gets through.
# Brevo → SMTP & API → API keys.
BREVO_API_KEY=

# -- Option B: Brevo over SMTP ----------------------------------------------
# Brevo → SMTP & API → SMTP. Used automatically if the API call ever fails.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<the login Brevo shows you, e.g. 8a1b2c001@smtp-brevo.com>
# SMTP_PASSWORD=<your Brevo SMTP key, starts xsmtpsib->

# IMPORTANT: SMTP_FROM must be an address VERIFIED in Brevo under
# "Senders, domains, IPs". Brevo rejects sends from anything else.
# SMTP_FROM=Mariluxbeautybar@gmail.com

# -- Option B: Gmail --------------------------------------------------------
# Turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords. Never use the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Mariluxbeautybar@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Mariluxbeautybar@gmail.com

# -- Option 2: Gmail API via OAuth2 (no app password needed) -----------------
# Used only when the SMTP variables above are absent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=Mariluxbeautybar@gmail.com

# Where new-booking notifications land.
OWNER_EMAIL=Mariluxbeautybar@gmail.com


# === SMS ===================================================================
# Both the client and the studio get an email AND a text for every booking, so
# if one is missed the other still lands.
#
# Set credentials for ONE provider. SMS_PROVIDER picks between them; leave it
# unset and the first configured one is used.
#
#   console   prints to the server log — for local testing, no account needed
#   arkesel   Ghana, cheapest per message          https://arkesel.com
#   hubtel    Ghana, same account as payments      https://hubtel.com
#   mnotify   Ghana                                https://mnotify.com
#   brevo     global — NOTE: Brevo SMS is paid credits, unlike its free email
#   twilio    global, most expensive for Ghana
SMS_PROVIDER=
# Alphanumeric sender shown on the client's phone. Ghanaian networks require
# this to be registered with your provider before it will deliver.
SMS_SENDER_ID=MARILUX
# Where the studio's own booking alerts are texted.
OWNER_SMS=0545489200

ARKESEL_API_KEY=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
MNOTIFY_API_KEY=
BREVO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=


# === WHATSAPP BUSINESS CLOUD API (optional, currently paused) ==============
# Leave these blank and WhatsApp is simply skipped — email and SMS carry
# everything. Turn it on when you have a number that is NOT in use on the
# WhatsApp phone app: registering a number to the Cloud API removes it from
# that app permanently. See WHATSAPP-SETUP.md.
# From Meta Business > WhatsApp > API Setup. Use a permanent system-user token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP=233545489200
# Meta only allows free-form text inside a 24-hour window, so client messages
# need an approved template. See WHATSAPP-SETUP.md — it gives you the exact
# template body to submit. The site sends six variables, in this order:
#   {{1}} first name  {{2}} status sentence  {{3}} service
#   {{4}} date        {{5}} time             {{6}} reference
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=en


# === PAYMENTS ==============================================================
# Paystack — Mobile Money and card.
PAYSTACK_SECRET_KEY=
# Set the webhook in the Paystack dashboard to:
#   https://<your-domain>/api/payments/webhook

# Hubtel — Ghana Mobile Money.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=

# Future providers: implement the PaymentProvider contract in
# src/lib/integrations/payments.ts and register them in PROVIDERS.
# STRIPE_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=


# === AUTOMATED REMINDERS (optional) ========================================
# Lets a cron job call POST /api/admin/reminders without an admin session:
#   curl -X POST https://<your-domain>/api/admin/reminders \
#        -H "x-cron-key: $CRON_SECRET"
# Run it once a day; it messages tomorrow's confirmed bookings and skips
# anyone already reminded.
CRON_SECRET=


# === DATABASE (Supabase) ===================================================
# Set this and bookings are stored in Postgres. Leave it unset and the app
# falls back to a local JSON file — fine for development, NOT for serverless
# hosts, whose filesystems are ephemeral.
#
# Supabase → Project Settings → Database → Connection string → Transaction
# pooler (port 6543). Percent-encode the password: % becomes %25, ? becomes
# %3F, $ becomes %24, * becomes %2A.
#
# Apply the schema with:  npm run db:migrate
DATABASE_URL=postgresql://postgres.<project-ref>:<encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=5

# Only used when DATABASE_URL is unset.
# BOOKINGS_DIR=/var/lib/marilux
