# ---------------------------------------------------------------------------
# Marilux Beauty Bar — environment
#
# Copy to `.env.local` and fill in what you have. Every integration degrades
# gracefully when its variables are absent: bookings are still recorded and
# acknowledged, and both the server log and the admin dashboard name exactly
# which channel needs attention.
# ---------------------------------------------------------------------------

# Public site URL. Canonical tags, sitemap, OG images and payment callbacks.
NEXT_PUBLIC_SITE_URL=https://mariluxbeautybar.com


# === ADMIN DASHBOARD (required to open /admin) =============================
# Without these the dashboard stays closed — there is no default password.
ADMIN_PASSWORD=choose-a-long-password
# Signs the session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=


# === EMAIL =================================================================
# Two options. SMTP is simplest and is what most studios should use.

# -- Option 1: SMTP (recommended) -------------------------------------------
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below. Never use the
# account's own password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Mariluxbeautybar@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Mariluxbeautybar@gmail.com

# -- Option 2: Gmail API via OAuth2 (no app password needed) -----------------
# Used only when the SMTP variables above are absent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=Mariluxbeautybar@gmail.com

# Where new-booking notifications land.
OWNER_EMAIL=Mariluxbeautybar@gmail.com


# === WHATSAPP BUSINESS CLOUD API ===========================================
# From Meta Business > WhatsApp > API Setup. Use a permanent system-user token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP=233545489200
# Meta only allows free-form text inside a 24-hour window. Once you have an
# approved template, put its name here and it is used for client messages.
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=en


# === PAYMENTS ==============================================================
# Paystack — Mobile Money and card.
PAYSTACK_SECRET_KEY=
# Set the webhook in the Paystack dashboard to:
#   https://<your-domain>/api/payments/webhook

# Hubtel — Ghana Mobile Money.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=

# Future providers: implement the PaymentProvider contract in
# src/lib/integrations/payments.ts and register them in PROVIDERS.
# STRIPE_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=


# === AUTOMATED REMINDERS (optional) ========================================
# Lets a cron job call POST /api/admin/reminders without an admin session:
#   curl -X POST https://<your-domain>/api/admin/reminders \
#        -H "x-cron-key: $CRON_SECRET"
# Run it once a day; it messages tomorrow's confirmed bookings and skips
# anyone already reminded.
CRON_SECRET=


# === STORAGE ===============================================================
# Where the JSON booking store is written. Defaults to ./.data
# NOTE: on serverless hosts (Vercel, Netlify) the filesystem is ephemeral —
# replace the repository in src/lib/store/bookings.ts with a real database
# before deploying there. See the README.
# BOOKINGS_DIR=/var/lib/marilux
