# ---------------------------------------------------------------------------
# Marilux Beauty Bar — environment
#
# Copy to `.env.local` and fill in. Every integration degrades gracefully when
# its variables are absent: bookings are still recorded and acknowledged, and
# the server log names exactly which channel needs attention.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonical tags, sitemap, OG images and payment callbacks.
NEXT_PUBLIC_SITE_URL=https://mariluxbeautybar.com

# --- Gmail (booking + enquiry email) ---------------------------------------
# Create an OAuth2 client in Google Cloud Console, authorise the studio's Gmail
# account with the https://www.googleapis.com/auth/gmail.send scope, and keep
# the refresh token here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=Mariluxbeautybar@gmail.com
OWNER_EMAIL=Mariluxbeautybar@gmail.com

# --- WhatsApp Business Cloud API -------------------------------------------
# From Meta Business > WhatsApp > API Setup. Use a permanent system-user token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP=233545489200
# Free-form text to customers is only allowed inside a 24-hour window. Once an
# approved template exists, put its name here and it will be used instead.
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=en

# --- Paystack (deposits: Mobile Money + card) ------------------------------
PAYSTACK_SECRET_KEY=
# Set the webhook URL in the Paystack dashboard to:
#   https://<your-domain>/api/payments/webhook

# --- Hubtel (Ghana Mobile Money) -------------------------------------------
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=

# --- Future providers -------------------------------------------------------
# Implement the PaymentProvider contract in src/lib/integrations/payments.ts
# and register them in PROVIDERS — nothing else needs to change.
# STRIPE_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
